# ─────────────────────────────────────────────
#  Business Analyzer — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Admin login ──────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ── Flask ────────────────────────────────────
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=false

# ── Google Maps Places API ───────────────────
# Get free key at: https://console.cloud.google.com
# Enable: Places API (New)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Apollo.io (decision-maker search) ────────
# Free plan: https://app.apollo.io → Settings → API
APOLLO_API_KEY=your_apollo_api_key_here

# ── Anthropic Claude AI ───────────────────────
# https://console.anthropic.com → API Keys
# Used for: personalized emails, lead scoring, counter-offer drafts
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Email sending (SMTP) ──────────────────────
# Gmail example: use App Password (not your real password)
# https://myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=you@gmail.com

# ── IMAP reply detection (optional) ──────────
# Same Gmail account works for both sending and receiving
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASS=your_app_password_here

# ── n8n webhook security (optional) ──────────
# Set a secret token to protect the /webhook/run-campaign endpoint
WEBHOOK_TOKEN=

# ── HTTPS mode (set true behind nginx/SSL) ───
HTTPS=false

# ── Twilio SMS / WhatsApp (optional) ─────────
# https://console.twilio.com → Account SID + Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
# For WhatsApp (use Twilio WhatsApp sandbox number):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
